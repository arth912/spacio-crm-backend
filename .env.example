# ==========================================
# SpaceIO / decoCRM Backend Environment Configuration Example
# Copy this file to .env and fill in your actual environment credentials
# ==========================================

# Database Connection (Supabase / PostgreSQL)
# Preferred: Supabase connection pooler URL (asyncpg format will be auto-translated if postgresql://)
supabase_pooler_url=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres
# Alternative options:
# supabase_url=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# JWT Authentication
# Required, min 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-generate-a-long-random-string

# SMTP Email Configuration (for OTP Verification & Password Reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@withspaceio.in
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM=hello@withspaceio.in
# Hostinger Mail API (optional; used instead of SMTP when set). Create the key in the Hostinger Mail API panel.
HOSTINGER_MAIL_API_KEY=
# Optional: mailbox resource ID (auto-detected from the key if empty)
HOSTINGER_MAIL_MAILBOX_ID=
# Where in-app user feedback is delivered
FEEDBACK_TO_EMAIL=hello@withspaceio.in

# Razorpay Integration (for Payments & Quotation Billing)
RAZORPAY_KEY_ID=rzp_test_xxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret


# Security / performance
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
# Path to Supabase CA cert to verify DB TLS
# DB_SSL_CA=/path/to/prod-ca-2021.crt
ACCESS_TOKEN_EXPIRE_MINUTES=120
SQL_ECHO=false
